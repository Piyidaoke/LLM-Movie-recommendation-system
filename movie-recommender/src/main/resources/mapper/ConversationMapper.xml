<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.movierecommender.mapper.ConversationMapper">

    <select id="findById" resultType="Conversation">
        SELECT * FROM tb_conversation WHERE conversation_id = #{conversationId}
    </select>

    <select id="findByUserId" resultType="Conversation">
        SELECT * FROM tb_conversation WHERE user_id = #{userId} ORDER BY updated_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="conversationId">
        INSERT INTO tb_conversation (user_id, title) VALUES (#{userId}, #{title})
    </insert>

    <update id="updateTitle">
        UPDATE tb_conversation SET title = #{title}, updated_at = NOW()
        WHERE conversation_id = #{conversationId}
    </update>

    <delete id="deleteById">
        DELETE FROM tb_conversation WHERE conversation_id = #{conversationId}
    </delete>
</mapper>
